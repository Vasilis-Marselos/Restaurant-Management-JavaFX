<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #f5f6fa;" stylesheets="@CSS/dashboard.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.RestaurantManagement.DashboardController">
    <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 36;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Label styleClass="dashboard-title" text="Στατιστικά Καταστήματος" />
        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="6" styleClass="dashboard-card">
                <Label styleClass="dashboard-card-title" text="Συνολικά Έσοδα" />
                <Label fx:id="totalIncomeLabel" styleClass="dashboard-card-value income" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="dashboard-card">
                <Label styleClass="dashboard-card-title" text="Έσοδα Σήμερα" />
                <Label fx:id="dayIncomeLabel" styleClass="dashboard-card-value income" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="dashboard-card">
                <Label styleClass="dashboard-card-title" text="Έσοδα Μήνα" />
                <Label fx:id="monthIncomeLabel" styleClass="dashboard-card-value income" />
            </VBox>
            <VBox alignment="CENTER" spacing="6" styleClass="dashboard-card">
                <Label styleClass="dashboard-card-title" text="Σύνολο Παραγγελιών" />
                <Label fx:id="ordersCountLabel" styleClass="dashboard-card-value" />
            </VBox>
        </HBox>
        <HBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="10" styleClass="dashboard-card table-card">
                <Label styleClass="dashboard-section-title" text="Top 5 Πιάτα" />
                <TableView fx:id="topDishesTable" prefHeight="170" prefWidth="280" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="dishNameCol" prefWidth="194.0" text="Πιάτο" />
                        <TableColumn fx:id="dishCountCol" prefWidth="84.0" text="Πλήθος" />
                    </columns>
                </TableView>
            </VBox>
            <VBox alignment="CENTER" spacing="10" styleClass="dashboard-card">
                <Label styleClass="dashboard-section-title" text="Έσοδα ανά Ημερομηνία" />
                <DatePicker fx:id="datePicker" />
                <Label styleClass="dashboard-card-title" text="Έσοδα:" />
                <Label fx:id="pickedDayIncomeLabel" styleClass="dashboard-card-value income" />
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
